{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nlmytgen.factory_queue.v1",
  "title": "NLMYTGen Bounded Factory Queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract",
    "queue",
    "evaluation_policy",
    "execution_authority_policy",
    "receipt_policy"
  ],
  "properties": {
    "schema": {
      "const": "nlmytgen.factory_queue.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_path",
        "schema_sha256"
      ],
      "properties": {
        "schema": {
          "const": "nlmytgen.factory_queue.contract.v1"
        },
        "schema_path": {
          "const": "schemas/factory_queue_v1/factory_queue_v1.schema.json"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "queue_id",
        "maximum_queue_size",
        "packages"
      ],
      "properties": {
        "schema": {
          "const": "nlmytgen.factory_queue.entries.v1"
        },
        "queue_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 96
        },
        "maximum_queue_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "descriptor_path",
              "expected_package_id",
              "expected_content_identity_sha256",
              "expected_render_settings_sha256",
              "expected_completed_output_sha256"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "descriptor_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\\\:]+$"
              },
              "expected_package_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$"
              },
              "expected_content_identity_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "expected_render_settings_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "expected_completed_output_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "immutable_artifact_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:[a-z0-9_.-]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ordering",
        "duplicate_package_id",
        "duplicate_content_identity",
        "target_collision",
        "render_on_change",
        "run_local_fields_excluded"
      ],
      "properties": {
        "schema": {
          "const": "nlmytgen.factory_queue.evaluation_policy.v1"
        },
        "ordering": {
          "const": "priority_descending_then_order_ascending"
        },
        "duplicate_package_id": {
          "const": "reject"
        },
        "duplicate_content_identity": {
          "const": "reject_unless_same_immutable_artifact_reference"
        },
        "target_collision": {
          "const": "reject"
        },
        "render_on_change": {
          "const": "plan_only_never_overwrite_completed_artifact"
        },
        "run_local_fields_excluded": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run_id",
              "timestamp",
              "pid",
              "elapsed_time",
              "local_directory",
              "machine_path"
            ]
          }
        }
      }
    },
    "execution_authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_only_default",
        "safe_stages_only",
        "source_project_generation_authorized",
        "render_authorized",
        "human_review_authorized",
        "private_artifact_copy_authorized"
      ],
      "properties": {
        "schema": {
          "const": "nlmytgen.factory_queue.execution_authority.v1"
        },
        "plan_only_default": {
          "const": true
        },
        "safe_stages_only": {
          "const": true
        },
        "source_project_generation_authorized": {
          "const": false
        },
        "render_authorized": {
          "const": false
        },
        "human_review_authorized": {
          "const": false
        },
        "private_artifact_copy_authorized": {
          "const": false
        }
      }
    },
    "receipt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "output_mode",
        "deterministic_fields_only",
        "include_usernames",
        "include_drive_letters",
        "include_private_absolute_paths",
        "include_credentials",
        "include_process_command_lines",
        "include_private_media"
      ],
      "properties": {
        "schema": {
          "const": "nlmytgen.factory_queue.receipt_policy.v1"
        },
        "output_mode": {
          "const": "sanitized_stdout"
        },
        "deterministic_fields_only": {
          "const": true
        },
        "include_usernames": {
          "const": false
        },
        "include_drive_letters": {
          "const": false
        },
        "include_private_absolute_paths": {
          "const": false
        },
        "include_credentials": {
          "const": false
        },
        "include_process_command_lines": {
          "const": false
        },
        "include_private_media": {
          "const": false
        }
      }
    }
  }
}
