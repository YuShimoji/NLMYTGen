{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nlmytgen.factory_queue.execution_journal.v1",
  "title": "NLMYTGen Derived Artifact Append-Only Execution Journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "plan_identity_sha256",
    "queue",
    "change_set",
    "execution_mode",
    "status",
    "entries",
    "counts",
    "boundaries"
  ],
  "properties": {
    "schema": {
      "const": "nlmytgen.factory_queue.execution_journal.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "plan_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "queue": {
      "$ref": "#/$defs/boundFile"
    },
    "change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_set_id",
        "path",
        "sha256"
      ],
      "properties": {
        "change_set_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/repoLocator"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_mode": {
      "enum": [
        "plan_only",
        "execute"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "succeeded",
        "failed",
        "effect_unknown"
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "package_id",
          "descriptor_path",
          "descriptor_sha256",
          "technical_decision",
          "requested_operation",
          "from_lifecycle",
          "to_lifecycle",
          "events",
          "current_state"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "package_id": {
            "$ref": "#/$defs/stableId"
          },
          "descriptor_path": {
            "$ref": "#/$defs/repoLocator"
          },
          "descriptor_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "technical_decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "requested_operation": {
            "oneOf": [
              {
                "enum": [
                  "source_project_generation",
                  "render",
                  "review_packet_generation"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "from_lifecycle": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_lifecycle": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "current_state": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[a-z0-9_.-]*[a-z0-9])?$"
    },
    "repoLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\:]+$"
    },
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoLocator"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "state": {
      "enum": [
        "not_selected",
        "verified_noop",
        "planned",
        "authority_validated",
        "started",
        "succeeded",
        "failed",
        "effect_unknown",
        "skipped_after_failure"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "state",
        "authority_id",
        "authority_status",
        "backend_result_identity_sha256",
        "failure_code",
        "consumer_effect"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "authority_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_status": {
          "oneOf": [
            {
              "enum": [
                "not_required",
                "not_consumed",
                "validated",
                "consumed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "backend_result_identity_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumer_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
