{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nlmytgen.factory_queue.execution_authority_set.derived_artifact.v1",
  "title": "NLMYTGen Derived Artifact One-Shot Authority Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authorities"
  ],
  "properties": {
    "schema": {
      "const": "nlmytgen.factory_queue.execution_authority_set.derived_artifact.v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "authority_id",
          "replaces_authority_id",
          "queue",
          "change_set",
          "package",
          "from_lifecycle",
          "to_lifecycle",
          "effect_class",
          "operation",
          "derived_artifact",
          "maximum_use_count",
          "status",
          "constraints"
        ],
        "properties": {
          "schema": {
            "const": "nlmytgen.factory_queue.execution_authority.derived_artifact.v1"
          },
          "authority_id": {
            "$ref": "#/$defs/stableId"
          },
          "replaces_authority_id": {
            "type": "null"
          },
          "queue": {
            "$ref": "#/$defs/boundFile"
          },
          "change_set": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "change_set_id",
              "sha256"
            ],
            "properties": {
              "change_set_id": {
                "$ref": "#/$defs/stableId"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package_id",
              "descriptor_path",
              "descriptor_sha256"
            ],
            "properties": {
              "package_id": {
                "$ref": "#/$defs/stableId"
              },
              "descriptor_path": {
                "$ref": "#/$defs/repoLocator"
              },
              "descriptor_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "from_lifecycle": {
            "const": "rendered"
          },
          "to_lifecycle": {
            "const": "rendered"
          },
          "effect_class": {
            "const": "derived_artifact"
          },
          "operation": {
            "const": "review_packet_generation"
          },
          "derived_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cue_id",
              "output_root",
              "generated_project_sha256",
              "source_mp4_sha256"
            ],
            "properties": {
              "cue_id": {
                "$ref": "#/$defs/stableId"
              },
              "output_root": {
                "$ref": "#/$defs/repoLocator"
              },
              "generated_project_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "source_mp4_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "maximum_use_count": {
            "const": 1
          },
          "status": {
            "enum": [
              "available",
              "consumed",
              "revoked"
            ]
          },
          "constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serial_only",
              "exact_identity_recheck",
              "derived_artifact_generation",
              "no_overwrite",
              "lifecycle_transition",
              "content_change",
              "private_artifact_copy",
              "human_acceptance",
              "rights",
              "production",
              "publication",
              "upload",
              "release"
            ],
            "properties": {
              "serial_only": {
                "const": true
              },
              "exact_identity_recheck": {
                "const": true
              },
              "derived_artifact_generation": {
                "const": true
              },
              "no_overwrite": {
                "const": true
              },
              "lifecycle_transition": {
                "const": false
              },
              "content_change": {
                "const": false
              },
              "private_artifact_copy": {
                "const": true
              },
              "human_acceptance": {
                "const": false
              },
              "rights": {
                "const": false
              },
              "production": {
                "const": false
              },
              "publication": {
                "const": false
              },
              "upload": {
                "const": false
              },
              "release": {
                "const": false
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[a-z0-9_.-]*[a-z0-9])?$"
    },
    "repoLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\:]+$"
    },
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoLocator"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
