      "owner": "agent after future operator authorization",
      "can_contain_live_source_data": true,
      "can_be_committed": false,
      "must_remain_local_ignored": true,
      "production_blocker_implications": "Blocks every downstream state if missing or if production_claim_allowed is true."
    },
    {
      "artifact_name": "feed_source_manifest",
