    "YukkuriMovieMaker.ViewModels.ScenarioEditorViewModel": {
      "Title": "",
      "SavedState": "{\"FilePath\":\"C:\\\\Users\\\\thank\\\\Storage\\\\Media Contents Projects\\\\NLMYTGen\\\\samples\\\\不動産DX_魔法の鍵とキュレーション_ymm4.csv\",\"IsSaved\":false,\"Lines\":[{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"もし街中の素晴らしい宝物が\\n全部隠されたなんか\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"秘密の図書館みたいな\\n場所に入るための魔法の\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"鍵があったとしたらどうでしょう?\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"ほう。秘密の図書館ですか?\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"はい。で、何十年もの間一部の\\n不動産業者だけがその鍵を\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"独占していたわけですよ。でも、えっと、\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"今や誰もがスマートフォンっていう\\n形でその鍵を持っているような\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"状態ですよね。\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"ああ、なるほど。確かにそうですね。\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"あなたが最後に引っ越しをした\\n時のことをちょっと\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"思い出し見て欲しいんですけど、\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"おそらくベッドに寝転がりながら\\n何千もの物件情報を\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"スワイプして自分で良さそうな\\n部屋を見つけたはずなんですよね。\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"ええ、今や誰もが\\n自分でいつでもどこでも簡単に\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"物件を検索できる時代になりましたからね。\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"情報へのアクセス権っていう\\n点では、あの、消費者と業者の\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"差はもうほぼなくなっています。\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"なのにですよ。私たちが実際に\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"契約する段階になると未だにその\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"ゲートキーパーである不動産仲介業者に\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"家賃の1ヶ月分とか売買なら数万円っていう\\n高額な手数料を払い続けていますよね。\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"そうですね。そこが今回の\\n最大の疑問点になってきます。\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"自分で検索したのになんでこんなに\"},{\"CharacterName\":\"ゆっくり魔理沙黄縁\",\"Text\":\"払うのかっていう。\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"今日この深掘り解説ではまさにその\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":\"謎に迫っていきたいと思います。\"},{\"CharacterName\":\"ゆっくり霊夢赤縁\",\"Text\":