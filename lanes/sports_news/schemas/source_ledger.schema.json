{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlmytgen.local/sports_news/source_ledger.schema.json",
  "title": "sports_news source ledger",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "publisher", "source_type", "retrieved_at", "use_as", "rights_note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "provider": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["official", "media", "journalist", "fan", "forum", "stats", "other"]
          },
          "retrieved_at": { "type": "string", "minLength": 1 },
          "use_as": {
            "type": "string",
            "enum": ["fact_reference", "data_reference", "reaction_reference", "blocked", "needs_review"]
          },
          "rights_note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
