{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlmytgen.local/sports_news/baseball_visual_data.schema.json",
  "title": "baseball visual data",
  "type": "object",
  "required": ["schema_version", "visual", "meta", "teams", "score", "atBat", "zone"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "baseball_visual_data.v1" },
    "visual": {
      "type": "object",
      "required": ["eventLabel", "claim", "sourceLabel", "watchPoint"],
      "additionalProperties": true,
      "properties": {
        "eventLabel": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "watchPoint": { "type": "string", "minLength": 1 },
        "ambientBackdrop": {
          "type": "object",
          "required": ["kind", "label", "imageUrl", "provenance", "usageStage"],
          "additionalProperties": true,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "imageUrl": { "type": "string" },
            "provenance": { "type": "string" },
            "usageStage": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["league", "date", "sourceEpisodeId"],
      "additionalProperties": true,
      "properties": {
        "league": { "type": "string", "minLength": 1 },
        "venue": { "type": "string" },
        "date": { "type": "string", "minLength": 1 },
        "weather": { "type": "string" },
        "attendance": { "type": "string" },
        "sourceEpisodeId": { "type": "string", "minLength": 1 }
      }
    },
    "teams": {
      "type": "object",
      "required": ["home", "away"],
      "additionalProperties": false,
      "properties": {
        "home": { "$ref": "#/$defs/team" },
        "away": { "$ref": "#/$defs/team" }
      }
    },
    "score": {
      "type": "object",
      "required": ["home", "away", "inning", "half", "outs", "balls", "strikes", "bases"],
      "additionalProperties": true,
      "properties": {
        "home": { "type": "integer" },
        "away": { "type": "integer" },
        "inning": { "type": "integer", "minimum": 1 },
        "half": { "type": "string", "enum": ["top", "bottom"] },
        "outs": { "type": "integer", "minimum": 0, "maximum": 2 },
        "balls": { "type": "integer", "minimum": 0, "maximum": 3 },
        "strikes": { "type": "integer", "minimum": 0, "maximum": 2 },
        "bases": {
          "type": "object",
          "required": ["first", "second", "third"],
          "additionalProperties": false,
          "properties": {
            "first": { "type": "boolean" },
            "second": { "type": "boolean" },
            "third": { "type": "boolean" }
          }
        }
      }
    },
    "atBat": {
      "type": "object",
      "required": ["pitcher", "batter", "pitches", "currentPitchIndex"],
      "additionalProperties": true,
      "properties": {
        "pitcher": { "$ref": "#/$defs/player" },
        "batter": { "$ref": "#/$defs/player" },
        "pitches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/pitch" }
        },
        "currentPitchIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "zone": {
      "type": "object",
      "required": ["halfWidth", "top", "bottom"],
      "additionalProperties": false,
      "properties": {
        "halfWidth": { "type": "number" },
        "top": { "type": "number" },
        "bottom": { "type": "number" }
      }
    }
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": ["code", "name", "shortName", "primary", "secondary", "logo"],
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "logo": { "type": "string", "minLength": 1 }
      }
    },
    "player": {
      "type": "object",
      "required": ["id", "name", "nameEn"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 },
        "number": {},
        "throws": { "type": "string" },
        "bats": { "type": "string" },
        "season": { "type": "object" },
        "today": { "type": "object" },
        "vsP": { "type": "object" }
      }
    },
    "pitch": {
      "type": "object",
      "required": ["num", "type", "typeJa", "mph", "kmh", "x", "y", "result", "resultJa", "claim"],
      "additionalProperties": true,
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "typeJa": { "type": "string", "minLength": 1 },
        "mph": { "type": "number" },
        "kmh": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "result": { "type": "string", "minLength": 1 },
        "resultJa": { "type": "string", "minLength": 1 },
        "zone": { "type": "string" },
        "intendedZone": {},
        "actualZone": {},
        "claim": { "type": "string", "minLength": 1 }
      }
    }
  }
}
