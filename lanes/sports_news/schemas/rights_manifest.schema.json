{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlmytgen.local/sports_news/rights_manifest.schema.json",
  "title": "sports_news publish gate manifest",
  "type": "object",
  "required": ["scope", "usage_stage", "status", "checks"],
  "additionalProperties": false,
  "properties": {
    "scope": { "const": "episode_publish_gate" },
    "usage_stage": {
      "type": "string",
      "enum": ["before_asset_ingest", "before_publish"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "blocked", "needs_review"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "gate", "status", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "gate": {
            "type": "string",
            "enum": ["provenance", "claim_source", "episode_consistency", "manual_review"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "blocked", "needs_review"]
          },
          "refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
