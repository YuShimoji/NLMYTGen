    "cue_evidence": [
      {
        "sequence": 1,
        "cue_id": "cue_001",
        "csv_row_id": "csv_row_1",
        "scene_id": "S1",
        "speaker": "れいむ",
        "text": "2024年に発行された新しいお札って、見た目以外にも変わったところがあるの？",
        "claim_ids": [
          "claim_010"
        ],
        "source_ids": [
          "V02"
        ],
        "source_backed_factual_boundary": "2024年発行だけを扱う。発行目的、経済効果、政策意図は示さない。",
        "timing": {
          "csv_row_id": "csv_row_1",
          "cue_id": "cue_001",
          "frame": 0,
          "length_frames": 391,
          "end_frame": 391
        }
      },
      {
        "sequence": 2,
        "cue_id": "cue_002",
        "csv_row_id": "csv_row_2",
        "scene_id": "S1",
        "speaker": "まりさ",
        "text": "あるぞ。偽造防止では、高精細すき入れや3Dホログラムなど複数の技術を組み合わせている。誰にとっても使いやすいユニバーサルデザインも取り入れたんだ。",
        "claim_ids": [
          "claim_090",
          "claim_065",
          "claim_099",
          "claim_161"
        ],
        "source_ids": [
          "V06",
          "V13",
          "V02"
        ],
        "source_backed_factual_boundary": "複数技術とユニバーサルデザインの採用意図まで。効果、優位性、新規性の実証は主張しない。",
        "timing": {
          "csv_row_id": "csv_row_2",
          "cue_id": "cue_002",
          "frame": 391,
          "length_frames": 705,
          "end_frame": 1096
        }
      },
      {
        "sequence": 3,
        "cue_id": "cue_003",
        "csv_row_id": "csv_row_3",
        "scene_id": "S2",
        "speaker": "まりさ",
        "text": "まずは高精細すき入れ。光に透かすと、細かな模様が見えるんだぜ。",
        "claim_ids": [
          "claim_090"
        ],
        "source_ids": [
          "V06"
        ],
        "source_backed_factual_boundary": "透過光で細かな模様が見えることだけを抽象化する。実券の肖像、位置、寸法、製法を再現しない。",
        "timing": {
          "csv_row_id": "csv_row_3",
          "cue_id": "cue_003",
          "frame": 1096,
          "length_frames": 338,
          "end_frame": 1434
        }
      },
      {
        "sequence": 4,
        "cue_id": "cue_004",
        "csv_row_id": "csv_row_4",
        "scene_id": "S2",
        "speaker": "まりさ",
        "text": "次は3Dホログラム。角度を変えると、三次元の肖像が回転して見えるぞ。",
        "claim_ids": [
          "claim_065",
          "claim_067"
        ],
        "source_ids": [
          "V06",
          "V07"
        ],
        "source_backed_factual_boundary": "角度で三次元の肖像が回転して見える現象を非肖像シルエットで示す。実際の形状、位置、箔模様は示さない。",
        "timing": {
          "csv_row_id": "csv_row_4",
          "cue_id": "cue_004",
          "frame": 1434,
          "length_frames": 384,
          "end_frame": 1818
        }
      },
      {
        "sequence": 5,
        "cue_id": "cue_005",
        "csv_row_id": "csv_row_5",
        "scene_id": "S2",
        "speaker": "れいむ",
        "text": "触るとざらざらするのは、額面数字などのインキを高く盛り上げる深凹版印刷なんだね。",
        "claim_ids": [
          "claim_116"
        ],
        "source_ids": [
          "V06"
        ],
        "source_backed_factual_boundary": "額面数字などの盛り上がりと触感だけを概念化する。版、工程、インキ高さなど再現可能な製造情報を示さない。",
        "timing": {
          "csv_row_id": "csv_row_5",
          "cue_id": "cue_005",
          "frame": 1818,
          "length_frames": 407,
          "end_frame": 2225
        }
      },
      {
        "sequence": 6,
        "cue_id": "cue_006",
        "csv_row_id": "csv_row_6",
        "scene_id": "S2",
        "speaker": "まりさ",
        "text": "マイクロ文字の『NIPPONGINKO』は、ルーペで確かめられる。カラーコピー機では再現が難しいほど小さい文字なんだ。",
        "claim_ids": [
          "claim_096",
          "claim_097"
        ],
        "source_ids": [
          "V06"
        ],
        "source_backed_factual_boundary": "NIPPONGINKOを単一の模式ラベルとして示す。実寸、密度、位置、周辺模様は再現せず、複写は困難という範囲に留める。",
        "timing": {
          "csv_row_id": "csv_row_6",
          "cue_id": "cue_006",
          "frame": 2225,
          "length_frames": 610,
          "end_frame": 2835
        }
      },
      {
        "sequence": 7,
        "cue_id": "cue_007",
        "csv_row_id": "csv_row_7",
        "scene_id": "S3",
        "speaker": "まりさ",
        "text": "見分けやすさの工夫では、識別マークを11本の斜線にそろえ、券種ごとに位置を変えているぜ。",
        "claim_ids": [
          "claim_118",
          "claim_130",
          "claim_132"
        ],
        "source_ids": [
          "V13",
          "V06",
          "V02"
        ],
        "source_backed_factual_boundary": "11本の斜線と券種別の位置差を模式図で示す。座標、角度、太さ、性能評価は示さない。",
        "timing": {
          "csv_row_id": "csv_row_7",
          "cue_id": "cue_007",
          "frame": 2835,
          "length_frames": 427,
          "end_frame": 3262
        }
      },
      {
        "sequence": 8,
        "cue_id": "cue_008",
        "csv_row_id": "csv_row_8",
        "scene_id": "S3",
        "speaker": "れいむ",
        "text": "額面の数字は前のシリーズのお札より大きい。一万円券と千円券ではホログラムの形や位置が違い、千円券の中央には橙色のグラデーションもあるんだね。",
        "claim_ids": [
          "claim_114",
          "claim_155",
          "claim_157"
        ],
        "source_ids": [
          "V02"
        ],
        "source_backed_factual_boundary": "E券より大きい額面数字、F券内の一万円券と千円券のホログラム差、千円券中央の橙色グラデーションだけを縮尺外の抽象図で示す。",
        "timing": {
          "csv_row_id": "csv_row_8",
          "cue_id": "cue_008",
          "frame": 3262,
          "length_frames": 733,
          "end_frame": 3995
        }
      },
      {
        "sequence": 9,
        "cue_id": "cue_009",
        "csv_row_id": "csv_row_9",
        "scene_id": "S3",
        "speaker": "まりさ",
        "text": "確かめ方は、透かす、触る、傾ける、ルーペで見る。この四つを覚えておこう。",
        "claim_ids": [
          "claim_090",
          "claim_116",
          "claim_065",
          "claim_096"
        ],
        "source_ids": [
          "V06"
        ],
        "source_backed_factual_boundary": "透かす・触る・傾ける・ルーペで見るを確認行動として示す。真贋保証や完全な判定手順とは扱わない。",
        "timing": {
